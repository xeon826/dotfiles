[Desktop Entry]
Version=1.0
Name=Helium
GenericName=Web Browser
Comment=Access the Internet
Exec=/home/dan/.local/bin/helium %U
StartupNotify=true
Terminal=false
Icon=net.imput.helium
Type=Application
Categories=Network;WebBrowser;
Actions=new-window;new-private-window;
MimeType=x-scheme-handler/unknown;x-scheme-handler/about;application/pdf;application/rdf+xml;application/rss+xml;application/xhtml+xml;application/xhtml_xml;application/xml;image/gif;image/jpeg;image/png;image/webp;text/html;text/xhtml+xml;text/xml;video/webm;x-scheme-handler/http;x-scheme-handler/https;

[Desktop Action new-window]
Name=New Window
Exec=/home/dan/.local/bin/helium

[Desktop Action new-private-window]
Name=New Incognito Window
Exec=/home/dan/.local/bin/helium --incognito
