+def _loads_lenient(text: str):
+    """``json.loads`` with one repair pass for common LLM JSON slop.
+
+    Some models (observed: DeepSeek) occasionally emit trailing commas
+    (``{..., }`` / ``[..., ]``), which strict parsing rejects. Strip any
+    comma directly preceding a closing brace/bracket and retry once.
+    """
+    try:
+        return json.loads(text)
+    except json.JSONDecodeError:
+        return json.loads(re.sub(r",\s*([}\]])", r"\1", text))
+
+
 def _extract_json_object(text: str) -> str:
     """First balanced {{...}} block in text (brace-balanced parser for nested/complex JSON)."""
     start = text.find("{")
