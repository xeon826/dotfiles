# EverOS server environment — loaded by ~/.config/systemd/user/everos.service
# via EnvironmentFile. Copy to ~/.config/everos/server.env (chmod 600) and fill
# in the key. Any OpenAI-protocol chat-completions endpoint works.
#
# Override convention: EVEROS_<SECTION>__<KEY> (docs: everos config precedence
# is default.toml < ~/.everos/everos.toml < .env < these envs).

EVEROS_LLM__MODEL=glm-5.3-flash
EVEROS_LLM__BASE_URL=https://api.z.ai/api/coding/paas/v4
EVEROS_LLM__API_KEY=<your-key-here>
EVEROS_LOG_LEVEL=info
