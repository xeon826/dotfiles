# EverOS server environment — loaded by ~/.config/systemd/user/everos.service
# via EnvironmentFile. Copy to ~/.config/everos/server.env (chmod 600) and fill
# in the keys. Any OpenAI-protocol chat-completions endpoint works for [llm];
# embeddings use an OpenAI-protocol /embeddings endpoint.
#
# Override convention: EVEROS_<SECTION>__<KEY> (docs: everos config precedence
# is default.toml < ~/.everos/everos.toml < .env < these envs).

EVEROS_LLM__MODEL=deepseek-chat
EVEROS_LLM__BASE_URL=https://api.deepseek.com/v1
EVEROS_LLM__API_KEY=<your-deepseek-key-here>
EVEROS_EMBEDDING__API_KEY=<your-dashscope-key-here>
EVEROS_LOG_LEVEL=info
